# Alisa — Telegram
TELEGRAM_TOKEN=replace_me
ADMIN_USER_ID=replace_with_numeric_telegram_user_id

# Gemini: up to 4 keys. Keep the numbered names exactly as shown.
GEMINI_API_KEY_1=replace_me
GEMINI_API_KEY_2=replace_me
GEMINI_API_KEY_3=replace_me
GEMINI_API_KEY_4=replace_me

# OpenAI: up to 2 keys.
OPENAI_API_KEY_1=replace_me
OPENAI_API_KEY_2=replace_me

# Model names are optional.
# If omitted, Alisa discovers a text-generation model supported by each key.
# You can override any individual key later with GEMINI_MODEL_1 or OPENAI_MODEL_1, etc.

# Optional runtime tuning
EMILY_DB_FILE=emily.db
EMILY_FREE_DAILY=50
EMILY_PREMIUM_DAILY=500
EMILY_HISTORY_MESSAGES=12
EMILY_MAX_MEMORIES=12
EMILY_AI_TIMEOUT=30
EMILY_KEY_COOLDOWN=20
